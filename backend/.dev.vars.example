# Copy to .dev.vars (gitignored) — wrangler dev overlays these on
# wrangler.toml [vars] for LOCAL runs only.
ENVIRONMENT=development
# Dev-only fake secrets so local wrangler dev can issue sessions
# (test-login, JWTs). Production values come from `wrangler secret put`.
AUTH_SECRET=local-dev-auth-secret-do-not-ship
REFRESH_TOKEN_ENC_KEY=bG9jYWwtZGV2LWtleS1sb2NhbC1kZXYta2V5LTEyMzQ=
GOOGLE_CLIENT_SECRET=local-dev-unused
GEMINI_API_KEY=local-dev-unused
# Local dev/e2e use the deterministic stub extractor (no AI cost).
AI_PROVIDER=stub
AI_DAILY_CAP=500
# "Send feedback" mail. Both are optional locally: there is no EMAIL
# binding in wrangler dev, so feedback is stored with
# email_status = unsent whatever these say — set them only to watch the
# route choose that status for the right reason in the logs. In
# production ADMIN_EMAILS is a secret (`wrangler secret put`), never a
# var, and FEEDBACK_FROM must be on an onboarded Email Sending domain.
ADMIN_EMAILS=
FEEDBACK_FROM=
