{
  "name": "gigsy-backend",
  "version": "0.0.69",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gigsy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gigsy-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "postal-mime": "^2.7.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "~2.1.0",
    "wrangler": "^4.0.0"
  }
}
